<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- COMMS: the camera scans a contact's pairing QR code; the relay connection
         runs in a foreground service of the remote-messaging type while the
         owner keeps comms online. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- COMMS calls: the microphone for the call itself, audio routing for
         speaker/earpiece, a microphone-type foreground service while a call is
         up, and a full-screen ring for incoming calls when the screen is off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- COMMS: lets the owner exempt Aegis from battery optimisation, which on
         many phones (Samsung especially) otherwise cuts the background relay
         connection so incoming calls never ring. Asked for from COMMS settings. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- COMMS calls: the proximity sensor switches the screen off at the ear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Wi-Fi anomaly scan reads the system's cached scan results only -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- NFC / HF RFID passive tag sweep -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Restart scanning after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Map tile downloads from OpenStreetMap. The tile server sees the device's IP
         address and which map area is being viewed; no detection data is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aegis">

        <!--
            Portrait only: the whole UI is laid out for it, and a rotation would
            recreate the Activity in the middle of a BiometricPrompt and drop the
            result the vault is waiting for.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aegis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- COMMS invites: the relay's invite page opens aegis://invite?c=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aegis" android:host="invite" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!--
            The call screen incoming-call and ongoing-call notifications open. It
            alone shows over the lock screen and turns the display on (declared
            here as well, so the system opens it from a locked phone without asking
            for the PIN first), and runs in its own task so ending the call returns
            to wherever the owner was. Not exported: only Aegis's own notifications
            can open it, so no other app can make Aegis answer a call.
        -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.xat.aegis.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aegis" />

        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An update stops the COMMS connection; bring it back. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Host Card Emulation service — replays recorded ISO 14443-4 APDU conversations so
            the phone can act as a stored access card. Only activates when the user explicitly
            enables emulation for a vault card; no data is sent until a reader initiates contact.
        -->
        <service
            android:name=".CardEmulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/hce_service"/>
        </service>

        <!--
            COMMS relay connection. Holds the WebSocket to the owner's relay while
            comms are online, so encrypted envelopes arrive the moment they are
            queued. When it is not running, a UnifiedPush wake-up (below) or opening
            the app fetches the inbox instead.
        -->
        <service
            android:name=".comms.CommsService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="remoteMessaging" />

        <!--
            UnifiedPush receiver: a distributor app the owner installs (ntfy, for
            example) wakes Aegis here. The push carries nothing; the app then
            fetches its inbox over the signed relay channel. No Google service.
        -->
        <service
            android:name=".comms.CommsPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!--
            An encrypted call in progress: holds the microphone and the WebRTC
            connection while the owner talks. Started only from an Aegis screen
            (placing a call, or answering one on the call screen).
        -->
        <service
            android:name=".comms.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Periodic check that the background relay connection is still alive. -->
        <receiver
            android:name=".comms.LinkWatchdog"
            android:exported="false" />

        <!-- Decline / hang-up buttons on call notifications. -->
        <receiver
            android:name=".comms.CallActionReceiver"
            android:exported="false" />

        <!-- Portrait QR scanner for pairing; the library's default is landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
